    "properties": {
      "text": {
        "type": "string",
        "description": "Raw PDF or OCR text to inspect and self-heal"
      }
    },
    "required": [
      "text"
    ],
    "additionalProperties": false
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "description": "Raw PDF or OCR text to inspect and self-heal"
      }
    },
    "required": [
      "text"
    ],
    "additionalProperties": false
  },
